class_name Sfx
extends Node
## Plays the placeholder sound effects from audio/sfx/ (generated by tools/make_sfx.py).
## A small pool of players, so overlapping sounds don't cut each other off. The pitch is set
## per play, which is how the count-up escalates.
##
## The count-up's note ladder (#60, D1) plays through play_note on one dedicated player outside
## the pool: notes are monophonic, so a new note cuts the last one and skipped beats can't stack
## notes. Today every note is the `bonus` G5 pitched from G4 to G6; #62 replaces only
## play_note's body with one file per pitch, so callers keep the same API.

const FOLDER := "res://audio/sfx"
const SOUNDS := [
	"scan",
	"bonus",
	"stamp",
	"print",
	"denied",
	"fizzle",
	"tag",
	"link",
	"copy",
	"total",
	"pass",
	"fail",
	"miss",
	"tick",
	"click",
	"ding",
]
const POOL_SIZE := 10
## The note ladder in semitones above G4: the C major pentatonic G4 A4 C5 D5 E5 G5 A5 C6 D6 E6
## G6. It ends on G, so the C-major total chord resolves it.
const LADDER_SEMITONES: Array[int] = [0, 2, 5, 7, 9, 12, 14, 17, 19, 21, 24]
## The sound play_note pitches, and its own note in ladder semitones (`bonus` is a G5).
const NOTE_SOUND := "bonus"
const NOTE_SOUND_SEMITONE := 12

var _streams: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
var _next: int = 0
var _note_player: AudioStreamPlayer


func _ready() -> void:
	for sound: String in SOUNDS:
		_streams[sound] = load("%s/%s.wav" % [FOLDER, sound])
	for i: int in range(POOL_SIZE):
		var player: AudioStreamPlayer = AudioStreamPlayer.new()
		add_child(player)
		_players.append(player)
	_note_player = AudioStreamPlayer.new()
	add_child(_note_player)


func play(sound: String, pitch: float = 1.0, volume_db: float = 0.0) -> void:
	var stream: AudioStream = _streams.get(sound) as AudioStream
	if stream == null or _players.is_empty():
		return
	var player: AudioStreamPlayer = _players[_next]
	_next = (_next + 1) % _players.size()
	player.stream = stream
	player.pitch_scale = clampf(pitch, 0.5, 3.0)
	player.volume_db = volume_db
	player.play()


## Plays note `index` of the ladder (clamped to 0..note_count() - 1) on the note player, cutting
## the note before it.
func play_note(index: int, volume_db: float = 0.0) -> void:
	var stream: AudioStream = _streams.get(NOTE_SOUND) as AudioStream
	if stream == null or _note_player == null:
		return
	_note_player.stream = stream
	_note_player.pitch_scale = note_pitch(index)
	_note_player.volume_db = volume_db
	_note_player.play()


## How many notes the ladder has (G4 to G6).
func note_count() -> int:
	return LADDER_SEMITONES.size()


## The pitch_scale that turns NOTE_SOUND into note `index` (clamped): 0.5 for G4 up to 2.0 for G6.
func note_pitch(index: int) -> float:
	var semitone: int = LADDER_SEMITONES[clampi(index, 0, LADDER_SEMITONES.size() - 1)]
	return pow(2.0, (semitone - NOTE_SOUND_SEMITONE) / 12.0)
