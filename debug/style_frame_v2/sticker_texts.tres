[gd_resource type="Resource" script_class="StickerTexts" load_steps=2 format=3]

[ext_resource type="Script" path="res://debug/style_frame_v2/sticker_texts.gd" id="1_sticker"]

[resource]
script = ExtResource("1_sticker")
templates = Dictionary[StringName, String]({
&"banana": "+{base} after {name}",
&"batteries": "+{bonus} in last slot",
&"cheese": "+{bonus} after Bread",
&"coffee": "+{bonus} next {tag}",
&"crisps": "+{bonus} beside Bread",
&"croissant": "+{bonus} beside {match_value}",
&"eggs": "×{factor} next {tag}",
&"milk": "+{bonus_each} per earlier {tag}",
&"multipack": "×{factor} later with prior's tag",
&"strawberries": "+{bonus} beside {match_value}",
&"tea_bags": "×{factor} next {tag}",
&"two_for_one": "Same both sides: 2nd ×{factor}"
})
