[gd_resource type="Resource" script_class="UpgradeDefinition" format=3]

[ext_resource type="Script" path="res://core/upgrades/upgrade_rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/upgrades/nth_product_multiplier_rule.gd" id="2_slot_engine"]
[ext_resource type="Script" path="res://core/upgrade_definition.gd" id="3_upgrade"]
[ext_resource type="Script" path="res://core/build_definition.gd" id="4_build"]
[ext_resource type="Resource" path="res://data/builds/breakfast_special.tres" id="5_breakfast_special"]

[sub_resource type="Resource" id="Resource_slot_engine"]
script = ExtResource("2_slot_engine")
product_number = 6
factor = 2
receipt_text = "Slot engine ×2"

[resource]
script = ExtResource("3_upgrade")
id = &"slot_engine"
display_name = "Slot engine"
type = 2
effect_text = "Your 6th product pays ×2"
condition_text = "Only the 6th product (coupons don't count); no effect with fewer than 6"
builds = Array[ExtResource("4_build")]([ExtResource("5_breakfast_special")])
rules = Array[ExtResource("1_rule")]([SubResource("Resource_slot_engine")])
