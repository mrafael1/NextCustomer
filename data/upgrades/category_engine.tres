[gd_resource type="Resource" script_class="UpgradeDefinition" format=3]

[ext_resource type="Script" path="res://core/upgrades/upgrade_rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/upgrades/distinct_tag_bonus_rule.gd" id="2_distinct_tags"]
[ext_resource type="Script" path="res://core/upgrade_definition.gd" id="3_upgrade"]

[sub_resource type="Resource" id="Resource_distinct_tags"]
script = ExtResource("2_distinct_tags")
bonus_per_tag = 3
receipt_text = "Category engine"

[resource]
script = ExtResource("3_upgrade")
id = &"category_engine"
display_name = "Category engine"
type = 3
effect_text = "+3 for each different tag among your products"
condition_text = "Paid on the last product in the row"
supported_build = "Mixed basket"
rules = Array[ExtResource("1_rule")]([SubResource("Resource_distinct_tags")])
