[ext_resource type="Script" path="res://core/rules/adjacent_match_bonus_rule.gd" id="2_croissant"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_croissant"]
script = ExtResource("2_croissant")
match_by = 3
match_value = "Bakery"
