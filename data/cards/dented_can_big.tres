[ext_resource type="Script" path="res://core/rules/count_earlier_tag_bonus_rule.gd" id="2_dented_can"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]
[ext_resource type="Resource" path="res://data/cards/dented_can.tres" id="9_plain"]

[sub_resource type="Resource" id="Resource_dented_can"]
script = ExtResource("2_dented_can")
