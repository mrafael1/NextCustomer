[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/batch_role_rule.gd" id="2_baguette"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_baguette"]
script = ExtResource("2_baguette")
tag = "Bakery"
role = 2
bonus = 4
max_count = 2
receipt_text = "Baguette fills batch"

[resource]
script = ExtResource("3_card")
id = &"baguette"
display_name = "Baguette"
kind = 1
tags = PackedStringArray("Food", "Bakery")
base = 2
rules = Array[ExtResource("1_rule")]([SubResource("Resource_baguette")])
rule_text = "+4€ for each earlier item in its BATCH (max 2)"
sticker_text = "{batch} +{bonus} per earlier"
monitor_text = "{batch} Gets +{bonus} for each earlier item in its batch (max {max_count})."
art_ref = "res://art/items_v2/baguette.png"
mini_art_ref = "res://art/minis/baguette.png"
mini_golden_art_ref = "res://art/minis/baguette_golden.png"
