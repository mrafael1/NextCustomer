[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/adjacent_match_bonus_rule.gd" id="2_butter"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_butter"]
script = ExtResource("2_butter")
match_by = 3
match_value = "Bakery"
position = 2
bonus = 4
per_match = true
pair = true
receipt_text = "Butter beside Bakery"

[resource]
script = ExtResource("3_card")
id = &"butter"
display_name = "Butter"
kind = 1
tags = PackedStringArray("Food", "Dairy")
base = 2
rules = Array[ExtResource("1_rule")]([SubResource("Resource_butter")])
rule_text = "PAIR: +4€ for each Bakery item beside it"
sticker_text = "+{bonus} {pair} per {match_value} beside"
monitor_text = "{pair} Gets +{bonus} for each {match_value} item beside it."
generally_useful = true
art_ref = "res://art/items_v2/butter.png"
mini_art_ref = "res://art/minis/butter.png"
mini_golden_art_ref = "res://art/minis/butter_golden.png"
