[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/adjacent_match_bonus_rule.gd" id="2_croissant"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]
[ext_resource type="Resource" path="res://data/cards/croissant.tres" id="9_plain"]

[sub_resource type="Resource" id="Resource_croissant"]
script = ExtResource("2_croissant")
match_by = 3
match_value = "Bakery"
position = 2
bonus = 2
