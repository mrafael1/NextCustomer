[ext_resource type="Script" path="res://core/rules/adjacent_match_bonus_rule.gd" id="2_reduced_yogurt"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_reduced_yogurt"]
script = ExtResource("2_reduced_yogurt")
match_by = 3
match_value = "Clearance"
position = 2
bonus = 4
per_match = true
pair = true
receipt_text = "Reduced yogurt beside Clearance"

[resource]
script = ExtResource("3_card")
id = &"reduced_yogurt"
display_name = "Reduced yogurt"
kind = 1
tags = PackedStringArray("Food", "Dairy", "Clearance")
base = 2
rules = Array[ExtResource("1_rule")]([SubResource("Resource_reduced_yogurt")])
