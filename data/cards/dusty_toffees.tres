[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/wasted_before_rule.gd" id="2_dusty_toffees"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_dusty_toffees"]
script = ExtResource("2_dusty_toffees")
bonus_each = 5
max_count = 3
receipt_text = "Dusty toffees: WASTED before"

[resource]
script = ExtResource("3_card")
id = &"dusty_toffees"
display_name = "Dusty toffees"
kind = 1
tags = PackedStringArray("Food", "Snack", "Clearance")
ticket_families = PackedStringArray("Clearance")
base = 2
rules = Array[ExtResource("1_rule")]([SubResource("Resource_dusty_toffees")])
rule_text = "+5 for each WASTED item before it, up to 3"
sticker_text = "+{bonus_each} per earlier {wasted}"
monitor_text = "Gets +{bonus_each} for each {wasted} item before it, up to {max_count}."
art_ref = "res://art/items_v2/dusty_toffees.png"
mini_art_ref = "res://art/minis/dusty_toffees.png"
mini_golden_art_ref = "res://art/minis/dusty_toffees_golden.png"
