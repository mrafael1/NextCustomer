[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/adjacent_match_bonus_rule.gd" id="2_breadsticks"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]
[ext_resource type="Resource" path="res://data/cards/breadsticks.tres" id="9_plain"]

[sub_resource type="Resource" id="Resource_breadsticks"]
script = ExtResource("2_breadsticks")
match_by = 2
match_value = "soup"
position = 1
bonus = 4
receipt_text = "Breadsticks after Soup"

[resource]
script = ExtResource("3_card")
id = &"breadsticks_golden"
display_name = "Golden Breadsticks"
kind = 1
tags = PackedStringArray("Food", "Snack")
base = 4
rules = Array[ExtResource("1_rule")]([SubResource("Resource_breadsticks")])
rule_text = "+4 if immediately after Soup"
art_ref = "res://art/items_v2/breadsticks_golden.png"
variant_of = ExtResource("9_plain")
tier = 2
