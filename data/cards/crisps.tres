[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/redraw_bonus_rule.gd" id="2_crisps"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_crisps"]
script = ExtResource("2_crisps")
bonus = 4
receipt_text = "Crisps: redraws left"

[resource]
script = ExtResource("3_card")
id = &"crisps"
display_name = "Crisps"
kind = 1
tags = PackedStringArray("Food", "Snack")
base = 2
rules = Array[ExtResource("1_rule")]([SubResource("Resource_crisps")])
rule_text = "+4 for each redraw left this shift"
sticker_text = "+{bonus} per redraw left"
monitor_text = "Gets +{bonus} for each redraw left this shift."
generally_useful = true
art_ref = "res://art/items_v2/crisps.png"
mini_art_ref = "res://art/minis/crisps.png"
mini_golden_art_ref = "res://art/minis/crisps_golden.png"
