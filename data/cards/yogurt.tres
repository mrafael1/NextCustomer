[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/adjacent_match_bonus_rule.gd" id="2_yogurt"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_yogurt"]
script = ExtResource("2_yogurt")
match_by = 2
match_value = "banana"
position = 2
bonus = 4
per_match = true
pair = true
receipt_text = "Yogurt PAIR with Banana"

[resource]
script = ExtResource("3_card")
id = &"yogurt"
display_name = "Yogurt"
kind = 1
tags = PackedStringArray("Food", "Dairy", "Breakfast")
base = 2
rules = Array[ExtResource("1_rule")]([SubResource("Resource_yogurt")])
rule_text = "PAIR: +4 for each Banana beside it"
sticker_text = "+{bonus} {pair} per Banana beside"
monitor_text = "{pair} Gets +{bonus} for each Banana beside it."
art_ref = "res://art/items_v2/yogurt.png"
mini_art_ref = "res://art/minis/yogurt.png"
mini_golden_art_ref = "res://art/minis/yogurt_golden.png"
