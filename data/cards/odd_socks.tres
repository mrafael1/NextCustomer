[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/pair_bonus_rule.gd" id="2_odd_socks"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_odd_socks"]
script = ExtResource("2_odd_socks")
tag = "Household"
bonus = 5
receipt_text = "Odd socks pair"

[resource]
script = ExtResource("3_card")
id = &"odd_socks"
display_name = "Odd socks"
kind = 1
tags = PackedStringArray("Household")
base = 1
rules = Array[ExtResource("1_rule")]([SubResource("Resource_odd_socks")])
rule_text = "+5 if it and one Household item sit side by side, with no other Household item touching either"
sticker_text = "+{bonus} beside only one {tag}"
art_ref = "res://art/items_v2/odd_socks.png"
mini_art_ref = "res://art/minis/odd_socks.png"
mini_golden_art_ref = "res://art/minis/odd_socks_golden.png"
