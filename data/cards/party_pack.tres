[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/grant_charged_multiplier_rule.gd" id="2_party_pack"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_party_pack"]
script = ExtResource("2_party_pack")
tag = "Snack"
factor = 2
charges = 3
receipt_text = "Party pack ×2"

[resource]
script = ExtResource("3_card")
id = &"party_pack"
display_name = "Party pack"
kind = 2
tags = PackedStringArray()
rules = Array[ExtResource("1_rule")]([SubResource("Resource_party_pack")])
rule_text = "The next 3 Snacks pay ×2"
sticker_text = "Next {charges} {tag}s ×{factor}"
monitor_text = "The next {charges} {tag} items pay ×{factor}, wherever they sit after it."
art_ref = "res://art/icons/coupon_party_pack_v2.png"
mini_art_ref = "res://art/icons/coupon_party_pack_mini.png"
needs_tag = "Snack"
