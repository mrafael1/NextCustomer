[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/grant_charged_multiplier_rule.gd" id="2_stale_popcorn"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_stale_popcorn"]
script = ExtResource("2_stale_popcorn")
tag = "Snack"
charges = 1
percent = 100
receipt_text = "Stale popcorn: redraws left"

[resource]
script = ExtResource("3_card")
id = &"stale_popcorn"
display_name = "Stale popcorn"
kind = 1
tags = PackedStringArray("Food", "Snack", "Clearance")
base = 2
rules = Array[ExtResource("1_rule")]([SubResource("Resource_stale_popcorn")])
rule_text = "The next Snack product pays ×1, +1 for each redraw left this shift"
sticker_text = "×{factor} next {tag}"
art_ref = "res://art/items_v2/stale_popcorn.png"
mini_art_ref = "res://art/minis/stale_popcorn.png"
mini_golden_art_ref = "res://art/minis/stale_popcorn_golden.png"
