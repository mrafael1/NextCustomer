[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/batch_role_rule.gd" id="2_stale_doughnut"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]
[ext_resource type="Resource" path="res://data/rules/bakery_batch_size.tres" id="99_batch_size"]

[sub_resource type="Resource" id="Resource_stale_doughnut"]
script = ExtResource("2_stale_doughnut")
tag = "Bakery"
role = 3
bonus = 3
receipt_text = "Stale doughnut closes batch"

[resource]
script = ExtResource("3_card")
id = &"stale_doughnut"
display_name = "Stale doughnut"
kind = 1
tags = PackedStringArray("Food", "Bakery", "Clearance")
base = 1
batch_bonus = ExtResource("99_batch_size")
rules = Array[ExtResource("1_rule")]([SubResource("Resource_stale_doughnut")])
rule_text = "LAST of a BATCH: +3€ for each item in it, itself included"
sticker_text = "{last} {batch}: +{bonus} per item"
monitor_text = "{batch} When {last} in its batch, gets +{bonus} for each item in it, itself included."
art_ref = "res://art/items_v2/stale_doughnut.png"
mini_art_ref = "res://art/minis/stale_doughnut.png"
mini_golden_art_ref = "res://art/minis/stale_doughnut_golden.png"
