[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/wasted_before_rule.gd" id="2_flickering_bulb"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_flickering_bulb"]
script = ExtResource("2_flickering_bulb")
factor = 3
receipt_text = "Flickering bulb after WASTED"

[resource]
script = ExtResource("3_card")
id = &"flickering_bulb"
display_name = "Flickering bulb"
kind = 1
tags = PackedStringArray("Household", "Clearance")
ticket_families = PackedStringArray("Clearance")
base = 1
rules = Array[ExtResource("1_rule")]([SubResource("Resource_flickering_bulb")])
rule_text = "×3 if the item right before it was WASTED"
sticker_text = "×{factor} after {wasted}"
generally_useful = true
art_ref = "res://art/items_v2/flickering_bulb.png"
mini_art_ref = "res://art/minis/flickering_bulb.png"
mini_golden_art_ref = "res://art/minis/flickering_bulb_golden.png"
