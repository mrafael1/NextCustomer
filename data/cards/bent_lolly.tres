[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/snack_spread_rule.gd" id="2_bent_lolly"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_bent_lolly"]
script = ExtResource("2_bent_lolly")
spread = 2
tag = "Snack"
bonus_each = 3
max_count = 3
receipt_text = "Bent lolly: gap to Snack"

[resource]
script = ExtResource("3_card")
id = &"bent_lolly"
display_name = "Bent lolly"
kind = 1
tags = PackedStringArray("Food", "Snack", "Clearance")
base = 2
rules = Array[ExtResource("1_rule")]([SubResource("Resource_bent_lolly")])
rule_text = "+3 for each item between it and the nearest other Snack, up to 3"
sticker_text = "+{bonus_each} per item to another {tag}"
monitor_text = "Gets +{bonus_each} for each item between it and the nearest other {tag}, up to {max_count}."
art_ref = "res://art/items_v2/bent_lolly.png"
mini_art_ref = "res://art/minis/bent_lolly.png"
mini_golden_art_ref = "res://art/minis/bent_lolly_golden.png"
