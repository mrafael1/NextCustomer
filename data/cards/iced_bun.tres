[ext_resource type="Script" path="res://core/rules/batch_role_rule.gd" id="2_iced_bun"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_iced_bun"]
script = ExtResource("2_iced_bun")
tag = "Bakery"
role = 4
