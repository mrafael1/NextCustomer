[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/chain_role_rule.gd" id="2_lemon"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_lemon"]
script = ExtResource("2_lemon")
role = 2
factor = 2
receipt_text = "Lemon knot"

[resource]
script = ExtResource("3_card")
id = &"lemon"
display_name = "Lemon"
kind = 1
tags = PackedStringArray("Food", "Produce")
base = 1
rules = Array[ExtResource("1_rule")]([SubResource("Resource_lemon")])
rule_text = "Between two Bananas: ties them into one chain, and the Banana after it adds twice the price of the one before it"
sticker_text = "{chain} middle: ×{factor} prev"
monitor_text = "{chain} Between two Bananas it ties them into one chain, and the Banana after it adds {times} the price of the one before it."
art_ref = "res://art/items_v2/lemon.png"
mini_art_ref = "res://art/minis/lemon.png"
mini_golden_art_ref = "res://art/minis/lemon_golden.png"
