[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/count_earlier_tag_bonus_rule.gd" id="2_pick_n_mix"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]
[ext_resource type="Resource" path="res://data/cards/pick_n_mix.tres" id="9_plain"]

[sub_resource type="Resource" id="Resource_pick_n_mix"]
script = ExtResource("2_pick_n_mix")
tag = "Snack"
bonus_each = 4
receipt_text = "Pick 'n' mix: earlier Snack"

[resource]
script = ExtResource("3_card")
id = &"pick_n_mix_golden"
display_name = "Golden Pick 'n' mix"
kind = 1
tags = PackedStringArray("Food", "Snack")
base = 3
rules = Array[ExtResource("1_rule")]([SubResource("Resource_pick_n_mix")])
rule_text = "+4 for each earlier Snack product"
art_ref = "res://art/items_v2/pick_n_mix_golden.png"
variant_of = ExtResource("9_plain")
tier = 2
