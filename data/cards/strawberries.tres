[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/chain_role_rule.gd" id="2_strawberries"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_strawberries"]
script = ExtResource("2_strawberries")
role = 1
bonus = 1
receipt_text = "Strawberries feed the chain"

[resource]
script = ExtResource("3_card")
id = &"strawberries"
display_name = "Strawberries"
kind = 1
tags = PackedStringArray("Food", "Produce")
base = 2
rules = Array[ExtResource("1_rule")]([SubResource("Resource_strawberries")])
rule_text = "Right before a CHAIN: +1€ to every Banana in it"
sticker_text = "+{bonus} each, next {chain}"
monitor_text = "{chain} Right before a chain, gives +{bonus} to every Banana in it."
generally_useful = true
art_ref = "res://art/items_v2/strawberries.png"
mini_art_ref = "res://art/minis/strawberries.png"
mini_golden_art_ref = "res://art/minis/strawberries_golden.png"
