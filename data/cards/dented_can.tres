[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://core/rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://core/rules/redraw_bonus_rule.gd" id="2_dented_can"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_dented_can"]
script = ExtResource("2_dented_can")
bonus_each = 2
receipt_text = "Dented can: cards redrawn"

[resource]
script = ExtResource("3_card")
id = &"dented_can"
display_name = "Dented can"
kind = 1
tags = PackedStringArray("Food", "Clearance")
base = 2
rules = Array[ExtResource("1_rule")]([SubResource("Resource_dented_can")])
rule_text = "+2 for each card redrawn this shift"
sticker_text = "+{bonus_each} per card redrawn"
art_ref = "res://art/items_v2/dented_can.png"
mini_art_ref = "res://art/minis/dented_can.png"
mini_golden_art_ref = "res://art/minis/dented_can_golden.png"
