[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"day_events"
group = &"run"
title = "DAY EVENTS"
mark = 2
mark_value = "DAY EVENTS"
rule = "A shift may have a DAY EVENT. Green is a GOOD DAY: a bonus for this shift. Red is an INSPECTION: a harder rule for this shift, like a closed slot or a higher QUOTA."
