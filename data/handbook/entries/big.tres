[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"big"
group = &"tiers"
title = "BIG"
mark = 2
mark_value = "BIG"
rule = "The middle tier: the same item with a higher price."
example_row = PackedStringArray("banana", "banana_big")
example_total = 8
details = "NEW ITEMS at the machine can hand out a BIG or GOLDEN item; UPGRADE turns a copy in your cart into the next tier. A BIG ticket looks like the plain one: only the price and the sprite change."
cards = PackedStringArray("banana_big", "milk_big")
