[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"coupon"
group = &"coupons"
title = "Coupon"
mark = 3
mark_value = "Coupon"
rule = "A {fam:Coupon} has no price of its own. It changes the items around it. A coupon between two items stops them being beside each other (except connectors like 2 for 1)."
