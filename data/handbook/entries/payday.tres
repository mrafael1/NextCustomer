[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"payday"
group = &"run"
title = "PAYDAY"
mark = 2
mark_value = "PAYDAY"
rule = "PAYDAY is the last shift of each WEEK, with 2 INSPECTIONS at once. Meet the QUOTA for 2 PREMIUM draws: every prize RARE or LEGENDARY. The last week ends with the FINAL PAYDAY: meet its QUOTA to win the run."
