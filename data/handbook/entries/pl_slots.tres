[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"pl_slots"
group = &"place"
title = "FIRST / LAST"
mark = 2
mark_value = "FIRST / LAST"
rule = "FIRST: the row's first slot, where {coupon:opening_deal} wants to be. LAST ITEM: the last item in the row (coupons skipped), which {coupon:final_markdown} doubles."
example_row = PackedStringArray("opening_deal", "bread", "final_markdown", "milk")
example_total = 35
