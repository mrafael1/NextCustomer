[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"shelf_swap"
group = &"coupons"
title = "Shelf swap"
mark = 4
mark_value = "shelf_swap"
rule = "Put different items on both sides of it: they count as side by side, and the second one pays ×2, like {item:cheese} beside {item:bread}."
example_row = PackedStringArray("bread", "shelf_swap", "cheese")
example_total = 21
