[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"shelf_swap"
group = &"coupons"
title = "Shelf swap"
mark = 4
mark_value = "shelf_swap"
rule = "Put it before an item: that item also counts as right after the row's first item, so {item:sugar_cubes} still follows {item:coffee}."
example_row = PackedStringArray("coffee", "bread", "shelf_swap", "sugar_cubes")
example_total = 15
