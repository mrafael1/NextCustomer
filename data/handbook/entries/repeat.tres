[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"repeat"
group = &"coupons"
title = "Repeat"
mark = 4
mark_value = "repeat"
rule = "Put it after a big earner: it pays what the item right before it pays, like {item:bread} doubled by {item:eggs}."
example_row = PackedStringArray("eggs", "bread", "repeat")
example_total = 21
