[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"two_for_one"
group = &"coupons"
title = "2 for 1"
mark = 4
mark_value = "two_for_one"
rule = "Put the same item on both sides of it, like {item:milk}: they count as side by side, and the second one pays ×2."
example_row = PackedStringArray("milk", "two_for_one", "milk")
example_total = 14
