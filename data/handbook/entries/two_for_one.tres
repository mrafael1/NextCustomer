[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"two_for_one"
group = &"coupons"
title = "2 for 1"
mark = 4
mark_value = "two_for_one"
rule = "With the same item on both sides, they count as side by side and the second pays ×2."
example_row = PackedStringArray("milk", "two_for_one", "milk")
example_total = 14
example_note = "The second Milk: 4 +1 for an earlier Breakfast, ×2."
details = "Not the same item on both sides: WASTED, and its window shows the cut line. A BIG or GOLDEN copy counts as the same item."
cards = PackedStringArray("milk", "banana")
