[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"fam_clearance"
group = &"families"
title = "Clearance"
mark = 3
mark_value = "Clearance"
rule = "Items with the Clearance glyph on their label. A rule that names Clearance counts every one of them."
example_row = PackedStringArray("dented_can", "bruised_apples")
example_total = 7
example_note = "Bruised apples pays beside a Clearance item."
details = "Bruised apples, Dented can, Day-old buns, Stale doughnut, Dusty toffees and more are Clearance. Dusty toffees and Flickering bulb profit from WASTED items. The Clearance tag makes the next item Clearance."
cards = PackedStringArray("bruised_apples", "dented_can", "dusty_toffees", "flickering_bulb")
