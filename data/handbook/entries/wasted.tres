[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"wasted"
group = &"keywords"
title = "WASTED"
mark = 1
mark_value = "WASTED"
rule = "If an item's rule does nothing where it sits, it's {kw:WASTED}. Some {fam:Clearance} items, like {item:dusty_toffees}, pay for {kw:WASTED} items."
example_row = PackedStringArray("banana", "bread", "banana", "dusty_toffees")
example_total = 16
