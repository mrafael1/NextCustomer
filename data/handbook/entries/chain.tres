[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"chain"
group = &"keywords"
title = "CHAIN"
mark = 1
mark_value = "CHAIN"
rule = "Put {items:banana} side by side to make a {kw:CHAIN}. Each {item:banana} adds the price of the one before it, so longer chains pay more."
example_row = PackedStringArray("banana", "banana", "banana", "banana")
example_total = 20
