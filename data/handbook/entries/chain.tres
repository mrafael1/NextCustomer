[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"chain"
group = &"keywords"
title = "CHAIN"
mark = 1
mark_value = "CHAIN"
rule = "2 or more Bananas linked one after another. Each Banana adds the price of the one before it. Each card's line says where by the chain it works."
example_row = PackedStringArray("banana", "banana", "banana", "banana")
example_total = 20
example_note = "Each Banana adds the price of the Banana before it."
details = "On the belt a green frame runs round the chain, with linked rings in each gap. Helpers have one place by it: Strawberries just before (+1 to each Banana, a clasp on the frame's left), Lemon inside (ties two Bananas), Wonky carrot just after (+2 per Banana, a clasp on the right). Anything else between two Bananas breaks it."
cards = PackedStringArray("banana", "strawberries", "lemon", "wonky_carrot")
