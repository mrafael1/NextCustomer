[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"morning"
group = &"keywords"
title = "MORNING"
mark = 1
mark_value = "MORNING"
rule = "Start the row with {fam:Breakfast} items to make a {kw:MORNING}; a {fam:Coupon} doesn't break it. Cards like {item:coffee} and {item:tea_bags} pay for it."
example_row = PackedStringArray("tea_bags", "bread", "milk", "potatoes", "coffee")
example_total = 38
