[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"fam_bakery"
group = &"families"
title = "Bakery"
mark = 3
mark_value = "Bakery"
rule = "Items with the Bakery glyph on their label. A rule that names Bakery counts every one of them."
example_row = PackedStringArray("croissant", "bread", "butter")
example_total = 14
example_note = "Croissant and Bread make a BATCH; Butter pairs with Bread."
details = "Bread, Crackers, Day-old buns, Baguette, Scone, Iced bun, Croissant, Broken biscuit, Squashed cake and Stale doughnut are Bakery. Side by side they make a BATCH; Butter pairs with any Bakery item."
cards = PackedStringArray("bread", "croissant", "baguette", "stale_doughnut", "iced_bun")
