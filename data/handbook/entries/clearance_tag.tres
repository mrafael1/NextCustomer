[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"clearance_tag"
group = &"coupons"
title = "Clearance tag"
mark = 4
mark_value = "clearance_tag"
rule = "The item in the next slot joins the Clearance family."
example_row = PackedStringArray("clearance_tag", "bread", "bruised_apples")
example_total = 10
example_note = "Bread is now Clearance, so Bruised apples (+3 beside Clearance) pays."
details = "Same WASTED cases as the Breakfast sticker."
cards = PackedStringArray("bread", "bruised_apples")
