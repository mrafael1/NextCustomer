[resource]
script = ExtResource("1_entry")
id = &"fam_dairy"
group = &"families"
title = "Dairy"
mark = 3
mark_value = "Dairy"
rule = "Items with the Dairy glyph on their label. A rule that names Dairy counts every one of them."
example_row = PackedStringArray("scone", "milk", "cream")
