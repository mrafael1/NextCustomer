example_note = "Scone pairs with Milk; Cream counts the PAIR."
details = "Milk, Cheese, Butter, Yogurt, Reduced yogurt and Cream are Dairy. Most make a PAIR with a partner; Cream pays per PAIR; Scone pairs with Dairy."
