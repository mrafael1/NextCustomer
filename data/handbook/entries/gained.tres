[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"gained"
group = &"shift"
title = "GAINED"
mark = 2
mark_value = "GAINED"
rule = "This item joined a family for this checkout only, from a sticker coupon or the Price gun."
example_row = PackedStringArray("breakfast_sticker", "potatoes", "milk")
example_total = 8
example_note = "Potatoes gains Breakfast."
details = "It counts for every rule in the row, never for builds or the cart. The ticket grows a second label row for the gained glyph."
cards = PackedStringArray("breakfast_sticker", "clearance_tag")
