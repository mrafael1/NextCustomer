[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"multipack"
group = &"coupons"
title = "Multipack"
mark = 4
mark_value = "multipack"
rule = "Put it after an item: later items of that item's family pay ×3. {fam:Food} and {fam:Breakfast} don't count."
