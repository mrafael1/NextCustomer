[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]
[ext_resource type="Texture2D" path="res://art/icons/bonus_ticket.png" id="2_icon"]

[resource]
script = ExtResource("1_entry")
id = &"receipt_rewards"
group = &"run"
title = "RECEIPT REWARDS"
mark = 5
icon = ExtResource("2_icon")
rule = "After each shift you pass, the RECEIPT REWARDS machine gives prizes. NEW ITEMS adds cards to your CART, and items can arrive BIG or GOLDEN. IMPROVE makes a card you own better (PLAIN, then BIG, then GOLDEN: each pays more) or gives a LOYALTY PERK. RARITY is how rare a prize is: COMMON, RARE or LEGENDARY. It is not the same as BIG or GOLDEN."
