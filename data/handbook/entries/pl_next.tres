[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"pl_next"
group = &"place"
title = "NEXT"
mark = 2
mark_value = "NEXT"
rule = "The first item of the named family later in the row, even past others: {item:eggs} doubles {item:bread}, the next {fam:Food} item."
example_row = PackedStringArray("eggs", "coffee", "bread")
example_total = 16
