[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"fam_food"
group = &"families"
title = "Food"
mark = 3
mark_value = "Food"
rule = "Most things you can eat. A rule that names Food counts every one of them; its glyph is left off the label when the item has another family."
example_row = PackedStringArray("eggs", "coffee", "bread")
example_total = 16
example_note = "Coffee is not Food, so Eggs' ×2 skips it and lands on Bread."
details = "Almost every product is Food except Coffee, Tea bags and Household goods. Eggs ×2 the next Food item; Mixed herbs +3 the next Food; Carrier bag +8 per Food beside it. Multipack ignores Food."
cards = PackedStringArray("eggs", "soup", "carrier_bag", "mixed_herbs")
