[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"fam_food"
group = &"families"
title = "Food"
mark = 3
mark_value = "Food"
rule = "{fam:Food} is on almost every item, even when its ticket shows only another family. {fam:Household} goods, {item:coffee} and {item:tea_bags} are not {fam:Food}. Some cards ignore it."
