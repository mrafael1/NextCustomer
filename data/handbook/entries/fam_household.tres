example_note = "Batteries ×2 the next Household item."
details = "Carrier bag, Scissors, Batteries, Flickering bulb, Chipped mug, Odd socks, Egg timer and Birthday candles are Household. Odd socks +5 in an exact Household pair. Not Food, so Eggs skip them."
cards = PackedStringArray("carrier_bag", "scissors", "batteries", "flickering_bulb")
