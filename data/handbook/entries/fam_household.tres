[resource]
script = ExtResource("1_entry")
id = &"fam_household"
group = &"families"
title = "Household"
mark = 3
mark_value = "Household"
rule = "Items with the Household glyph on their label. A rule that names Household counts every one of them."
example_row = PackedStringArray("batteries", "scissors")
