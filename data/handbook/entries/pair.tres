[gd_resource type="Resource" script_class="HandbookEntry" format=3]

[ext_resource type="Script" path="res://presentation/handbook_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
id = &"pair"
group = &"keywords"
title = "PAIR"
mark = 1
mark_value = "PAIR"
rule = "Put a {kw:PAIR} item beside the partner its card names, like {item:cheese} by {item:bread}, for a bonus. {item:cream} pays for each PAIRED item in the row."
example_row = PackedStringArray("butter", "bread", "cheese", "cream")
example_total = 29
