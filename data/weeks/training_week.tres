[gd_resource type="Resource" script_class="WeekEventDefinition" format=3]

[ext_resource type="Script" path="res://core/week_event_definition.gd" id="1_week"]

[resource]
script = ExtResource("1_week")
forgives_slips = true
id = &"training_week"
display_name = "Training week"
tone = 2
notice_text = "Training week: you can miss the quota 2 times (a miss gets no prizes). Next week, a miss ends the run."
chip_text = "TRAINING"
