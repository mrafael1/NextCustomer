[sub_resource type="Resource" id="Resource_g22"]
script = ExtResource("2_sub")
id = &"G22"
screen = 4
text = "Press **CHECKOUT**. Your **ROW** pays from left to right, and the bar fills up to the **QUOTA**."
teaches = PackedStringArray("CHECKOUT")
rings = Array[StringName]([&"checkout"])
