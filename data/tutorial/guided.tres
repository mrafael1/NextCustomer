allow_ids = Array[StringName]([&"primary", &"tab2"])

[sub_resource type="Resource" id="Resource_g6"]
script = ExtResource("2_sub")
id = &"G6"
screen = 2
text = "Pick one **STARTER PACK**. Its **CARDS** join your **CART**. Point at a pack to read it."
