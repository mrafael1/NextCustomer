allow_cards = Array[StringName]([&"eggs"])
allow_slots = PackedInt32Array(0)
checks_row = true
row_before = Array[StringName]([&"bread", &"cheese", &"eggs"])

[sub_resource type="Resource" id="Resource_g16"]
script = ExtResource("2_sub")
id = &"G16"
screen = 4
text = "Bread now pays ×{eggs_times}: {bread_doubled}€. Same **CARDS**, new order: {row_right}€, not {row_wrong}€. Order is the whole game."
rings = Array[StringName]([&"slot1", &"slot2", &"proj"])
