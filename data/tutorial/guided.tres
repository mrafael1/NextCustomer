[sub_resource type="Resource" id="Resource_g13"]
script = ExtResource("2_sub")
id = &"G13"
screen = 4
text = "+{cheese_bonus}€! Cheese ({cheese_price}€) **BESIDE** Bread is a **PAIR**: {pair_pays}€. Your **ROW** pays {row_pair}€."
