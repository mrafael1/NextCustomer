[sub_resource type="Resource" id="Resource_g8"]
script = ExtResource("2_sub")
id = &"G8"
screen = 4
text = "This is your till. Each **SHIFT**, you put **ITEMS** from your **BASKETS** in the **ROW**."
teaches = PackedStringArray("ITEM", "BASKETS", "ROW")
rings = Array[StringName]([&"tickets", &"baskets"])
act = -1
side = 3
locks = Array[StringName]([&"checkout", &"redraw", &"medals"])
gate = 1
checks_row = true

[sub_resource type="Resource" id="Resource_g9"]
script = ExtResource("2_sub")
id = &"G9"
screen = 4
text = "Reach the **QUOTA** to pass the **SHIFT**. This **SHIFT**, it is {quota}€."
teaches = PackedStringArray("QUOTA")
rings = Array[StringName]([&"quota"])
act = -1
side = 2
locks = Array[StringName]([&"checkout", &"redraw", &"medals"])
gate = 1
checks_row = true

