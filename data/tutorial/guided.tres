[sub_resource type="Resource" id="Resource_g23"]
script = ExtResource("2_sub")
id = &"G23"
screen = 5
text = "**QUOTA** met! Pick a key, then PUSH. **NEW ITEMS**: new **CARDS** for your **CART**. **IMPROVE**: make a **CARD** better, or get a **LOYALTY PERK**."
teaches = PackedStringArray("RECEIPT REWARDS", "NEW ITEMS", "IMPROVE", "LOYALTY PERKS")
rings = Array[StringName]([&"machine_keys", &"machine_push"])
act = 0
side = 2
footer = 2
advance_on = &"chute_chosen"

[sub_resource type="Resource" id="Resource_g24"]
script = ExtResource("2_sub")
id = &"G24"
screen = 6
text = "Keep 1 prize, or **SKIP** them all. **RARE** and **LEGENDARY** prizes are harder to find."
teaches = PackedStringArray("RARITY")
rings = Array[StringName]([&"machine_prizes", &"machine_skip"])
act = 0
side = 1
footer = 2
advance_on = &"machine_returned"

[sub_resource type="Resource" id="Resource_g25"]
script = ExtResource("2_sub")
id = &"G25"
screen = 7
text = "A **WEEK** is {week_shifts} **SHIFTS**. **PAYDAY** is the last. In training **WEEK** you can **MISS** the **QUOTA** {misses} times. After that, one **MISS** ends the run."
teaches = PackedStringArray("WEEK", "PAYDAY", "MISS")
rings = Array[StringName]([&"week_card"])
act = -1
side = 2

[sub_resource type="Resource" id="Resource_g26"]
script = ExtResource("2_sub")
id = &"G26"
screen = 7
text = "That's the basics! New things get a quick tip the first time. Look up any word in the **HANDBOOK**, in the menu."
teaches = PackedStringArray("HANDBOOK")
rings = Array[StringName]([&"menu"])
act = -1
side = 1
footer = 1

