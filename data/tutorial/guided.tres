[sub_resource type="Resource" id="Resource_g15"]
script = ExtResource("2_sub")
id = &"G15"
screen = 4
text = "**WASTED**: no Food **ITEM** comes **LATER**, so the **RULE** did nothing. Drag Eggs to slot 1. Bread and Cheese slide right."
teaches = PackedStringArray("WASTED")
rings = Array[StringName]([&"slot2", &"slot0"])
act = 0
side = 2
locks = Array[StringName]([&"checkout", &"redraw", &"medals"])
footer = 2
advance_on = &"card_placed"
gate = 1
