[gd_resource type="Resource" script_class="QuickTutorial" load_steps=3 format=3]

[ext_resource type="Script" path="res://presentation/tutorial/quick_tutorial.gd" id="1_main"]
[ext_resource type="Script" path="res://presentation/tutorial/tutorial_step.gd" id="2_sub"]
[ext_resource type="Script" path="res://presentation/tutorial/quick_hint.gd" id="3_hint"]

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("2_sub")
id = &"P1"
screen = 2
text = "You earned a **BADGE PIN**: wear it to change a rule for this run."
teaches = PackedStringArray("BADGE PINS")
rings = Array[StringName]([&"pin_row0", &"wear0"])
act = 1
side = 2
footer = 1
advance_on = &"pin_toggled"

[resource]
script = ExtResource("1_main")
id = &"pins"
title = "BADGE PINS"
order = 3
trigger = &"pins_earned"
steps = Array[ExtResource("2_sub")]([SubResource("Resource_p1")])
hints = Array[ExtResource("3_hint")]([])
