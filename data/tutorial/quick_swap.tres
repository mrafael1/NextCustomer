[gd_resource type="Resource" script_class="QuickTutorial" load_steps=4 format=3]

[ext_resource type="Script" path="res://presentation/tutorial/quick_tutorial.gd" id="1_main"]
[ext_resource type="Script" path="res://presentation/tutorial/tutorial_step.gd" id="2_sub"]
[ext_resource type="Script" path="res://presentation/tutorial/quick_hint.gd" id="3_hint"]

[sub_resource type="Resource" id="Resource_sa1"]
script = ExtResource("2_sub")
id = &"SA1"
screen = 1
text = "You can now swap one of your regulars: click the basket."
teaches = PackedStringArray("SWAP")
rings = Array[StringName]([&"crate"])
act = 0
side = 2
footer = 1
advance_on = &"swap_opened"

[sub_resource type="Resource" id="Hint_sa3"]
script = ExtResource("3_hint")
id = &"swap_drag"
event = &"swap_booster_opened"
title = "SWAP"
text = "Drag a card onto a regular to swap them."
teaches = PackedStringArray()
anchor = "swap_regular0"

[resource]
script = ExtResource("1_main")
id = &"swap"
title = "SWAP"
order = 1
trigger = &"swap_unlocked"
steps = Array[ExtResource("2_sub")]([SubResource("Resource_sa1")])
hints = Array[ExtResource("3_hint")]([SubResource("Hint_sa3")])
