[gd_resource type="Resource" script_class="GuidedStartDefinition" format=3]

[ext_resource type="Script" path="res://core/guided_start_definition.gd" id="1_guide"]
[ext_resource type="Script" path="res://core/guided_booster_spec.gd" id="2_spec"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="3_card"]
[ext_resource type="Resource" path="res://data/decks/guided_starter.tres" id="4_recipe"]
[ext_resource type="Resource" path="res://data/aisles/dairy.tres" id="5_dairy"]
[ext_resource type="Resource" path="res://data/aisles/pantry.tres" id="6_pantry"]
[ext_resource type="Resource" path="res://data/cards/cheese.tres" id="c_cheese"]
[ext_resource type="Resource" path="res://data/cards/butter.tres" id="c_butter"]
[ext_resource type="Resource" path="res://data/cards/yogurt.tres" id="c_yogurt"]
[ext_resource type="Resource" path="res://data/cards/reduced_yogurt.tres" id="c_reduced_yogurt"]
[ext_resource type="Resource" path="res://data/cards/cereal.tres" id="c_cereal"]
[ext_resource type="Resource" path="res://data/cards/tea_bags.tres" id="c_tea_bags"]
[ext_resource type="Resource" path="res://data/cards/crackers.tres" id="c_crackers"]
[ext_resource type="Resource" path="res://data/cards/dented_can.tres" id="c_dented_can"]
[ext_resource type="Resource" path="res://data/cards/banana.tres" id="h_banana"]
[ext_resource type="Resource" path="res://data/cards/eggs.tres" id="h_eggs"]
[ext_resource type="Resource" path="res://data/cards/milk.tres" id="h_milk"]

[sub_resource type="Resource" id="Resource_dairy"]
script = ExtResource("2_spec")
aisle = ExtResource("5_dairy")
cards = Array[ExtResource("3_card")]([ExtResource("c_cheese"), ExtResource("c_butter"), ExtResource("c_yogurt"), ExtResource("c_reduced_yogurt")])

[sub_resource type="Resource" id="Resource_pantry"]
script = ExtResource("2_spec")
aisle = ExtResource("6_pantry")
cards = Array[ExtResource("3_card")]([ExtResource("c_cereal"), ExtResource("c_tea_bags"), ExtResource("c_crackers"), ExtResource("c_dented_can")])

[resource]
script = ExtResource("1_guide")
recipe = ExtResource("4_recipe")
boosters = Array[ExtResource("2_spec")]([SubResource("Resource_dairy"), SubResource("Resource_pantry")])
hand = Array[ExtResource("3_card")]([ExtResource("h_banana"), ExtResource("h_banana"), ExtResource("h_milk"), ExtResource("h_eggs"), ExtResource("c_yogurt"), ExtResource("c_cereal"), ExtResource("c_tea_bags"), ExtResource("c_cheese")])
