[gd_resource type="Resource" script_class="StarterPackDefinition" format=3]

[ext_resource type="Script" path="res://core/starter_pack_definition.gd" id="1_pack"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="2_card"]
[ext_resource type="Resource" path="res://data/cards/bread.tres" id="c_bread"]
[ext_resource type="Resource" path="res://data/cards/cheese.tres" id="c_cheese"]
[ext_resource type="Resource" path="res://data/cards/butter_big.tres" id="c_butter_big"]

[resource]
script = ExtResource("1_pack")
id = &"deli_counter"
display_name = "Deli counter"
family = "Bakery"
cards = Array[ExtResource("2_card")]([ExtResource("c_bread"), ExtResource("c_cheese"), ExtResource("c_butter_big")])
hint_text = "Bread in the middle: Butter pays +3 beside Bakery, Cheese +4 beside Bread."
example_text = "Big Butter, Bread, Cheese: Big Butter pays 4 + 3, Bread 5, Cheese 3 + 4. Total 19."
example_cards = Array[ExtResource("2_card")]([ExtResource("c_butter_big"), ExtResource("c_bread"), ExtResource("c_cheese")])
example_total = 19
