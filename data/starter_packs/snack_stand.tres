[resource]
script = ExtResource("1_pack")
id = &"snack_stand"
display_name = "Snack stand"
family = "Snack"
cards = Array[ExtResource("2_card")]([ExtResource("c_crisps"), ExtResource("c_pick_n_mix"), ExtResource("c_bent_lolly_big")])
hint_text = "Keep Snacks apart: Pick 'n' mix +4 per lone Snack, Bent lolly +3 per gap item."
example_text = "Crisps, Milk, Pick 'n' mix, Banana, Big Bent lolly: three lone Snacks, so Pick 'n' mix pays 2 + 12 and the lolly 4 + 3. Total 29."
example_cards = Array[ExtResource("2_card")]([ExtResource("c_crisps"), ExtResource("e_milk"), ExtResource("c_pick_n_mix"), ExtResource("e_banana"), ExtResource("c_bent_lolly_big")])
example_total = 29
needs_aisle = &"snacks"
