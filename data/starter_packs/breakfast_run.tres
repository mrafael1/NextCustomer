[gd_resource type="Resource" script_class="StarterPackDefinition" format=3]

[ext_resource type="Script" path="res://core/starter_pack_definition.gd" id="1_pack"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="2_card"]
[ext_resource type="Resource" path="res://data/cards/family_sticker.tres" id="c_family_sticker"]
[ext_resource type="Resource" path="res://data/cards/coffee.tres" id="c_coffee"]
[ext_resource type="Resource" path="res://data/cards/tea_bags_big.tres" id="c_tea_bags_big"]
