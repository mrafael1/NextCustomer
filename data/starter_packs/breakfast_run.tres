[resource]
script = ExtResource("1_pack")
id = &"breakfast_run"
display_name = "Breakfast run"
family = "Breakfast"
cards = Array[ExtResource("2_card")]([ExtResource("c_family_sticker"), ExtResource("c_coffee"), ExtResource("c_tea_bags_big")])
hint_text = "Line up MORNING items: Coffee pays +1 for each, Tea bags ×4 the last one after it."
example_text = "Family sticker, Banana, Coffee, Big Tea bags, Milk: Coffee pays 6, Big Tea bags turns Milk's 7 into 28. Total 39."
example_cards = Array[ExtResource("2_card")]([ExtResource("c_family_sticker"), ExtResource("e_banana"), ExtResource("c_coffee"), ExtResource("c_tea_bags_big"), ExtResource("e_milk")])
example_total = 39
sticker_family = "Breakfast"
former_cards = Array[ExtResource("2_card")]([ExtResource("f_breakfast_sticker"), ExtResource("c_coffee"), ExtResource("c_tea_bags_big")])
