[resource]
script = ExtResource("1_pack")
id = &"breakfast_run"
display_name = "Breakfast run"
family = "Breakfast"
cards = Array[ExtResource("2_card")]([ExtResource("c_family_sticker"), ExtResource("c_coffee"), ExtResource("c_tea_bags_big")])
hint_text = "Breakfast in the first 3 slots is MORNING: Coffee +1€ each, Tea bags ×4 the last one."
example_text = "Big tea bags, Coffee, Milk: Coffee pays 5, Big tea bags turns Milk's 6 into 24. Total 32."
example_cards = Array[ExtResource("2_card")]([ExtResource("c_tea_bags_big"), ExtResource("c_coffee"), ExtResource("e_milk")])
example_total = 32
sticker_family = "Breakfast"
former_cards = Array[ExtResource("2_card")]([ExtResource("f_breakfast_sticker"), ExtResource("c_coffee"), ExtResource("c_tea_bags_big")])
