[gd_resource type="Resource" script_class="StarterPackDefinition" format=3]

[ext_resource type="Script" path="res://core/starter_pack_definition.gd" id="1_pack"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="2_card"]
[ext_resource type="Resource" path="res://data/cards/repeat.tres" id="c_repeat"]
[ext_resource type="Resource" path="res://data/cards/shelf_swap.tres" id="c_shelf_swap"]
[ext_resource type="Resource" path="res://data/cards/scissors.tres" id="c_scissors"]
[ext_resource type="Resource" path="res://data/cards/milk.tres" id="e_milk"]
[ext_resource type="Resource" path="res://data/cards/eggs.tres" id="e_eggs"]

[resource]
script = ExtResource("1_pack")
id = &"coupon_clipper"
display_name = "Coupon clipper"
family = "Coupon"
cards = Array[ExtResource("2_card")]([ExtResource("c_repeat"), ExtResource("c_shelf_swap"), ExtResource("c_scissors")])
hint_text = "Coupons early, Scissors late: +3€ per earlier coupon. Repeat copies the item before it."
example_text = "Milk, Repeat, Eggs, Shelf swap, Scissors: Repeat copies Milk's 4, Shelf swap doubles Scissors' 2 + 6. Total 25."
example_cards = Array[ExtResource("2_card")]([ExtResource("e_milk"), ExtResource("c_repeat"), ExtResource("e_eggs"), ExtResource("c_shelf_swap"), ExtResource("c_scissors")])
example_total = 25
