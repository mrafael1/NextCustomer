[gd_resource type="Resource" script_class="StarterPackDefinition" format=3]

[ext_resource type="Script" path="res://core/starter_pack_definition.gd" id="1_pack"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="2_card"]
[ext_resource type="Resource" path="res://data/cards/write_off.tres" id="c_write_off"]
[ext_resource type="Resource" path="res://data/cards/dented_can.tres" id="c_dented_can"]
[ext_resource type="Resource" path="res://data/cards/flickering_bulb.tres" id="c_flickering_bulb"]
[ext_resource type="Resource" path="res://data/cards/milk.tres" id="e_milk"]
[ext_resource type="Resource" path="res://data/cards/clearance_tag.tres" id="f_clearance_tag"]
[ext_resource type="Resource" path="res://data/cards/flickering_bulb_big.tres" id="f_flickering_bulb_big"]

[resource]
script = ExtResource("1_pack")
id = &"bargain_bin"
display_name = "Bargain bin"
family = "Clearance"
cards = Array[ExtResource("2_card")]([ExtResource("c_write_off"), ExtResource("c_dented_can"), ExtResource("c_flickering_bulb")])
hint_text = "Write-off makes the next item WASTED, so Flickering bulb pays ×4 after it."
example_text = "Write-off, Milk, Flickering bulb: Write-off doubles Milk's 4 and makes it WASTED, so the bulb pays 2 ×4. Total 16."
example_cards = Array[ExtResource("2_card")]([ExtResource("c_write_off"), ExtResource("e_milk"), ExtResource("c_flickering_bulb")])
example_total = 16
former_cards = Array[ExtResource("2_card")]([ExtResource("f_clearance_tag"), ExtResource("c_dented_can"), ExtResource("f_flickering_bulb_big")])
