[gd_resource type="Resource" script_class="StarterPackDefinition" format=3]

[ext_resource type="Script" path="res://core/starter_pack_definition.gd" id="1_pack"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="2_card"]
[ext_resource type="Resource" path="res://data/cards/final_markdown.tres" id="c_final_markdown"]
[ext_resource type="Resource" path="res://data/cards/yogurt.tres" id="c_yogurt"]
[ext_resource type="Resource" path="res://data/cards/carrier_bag_big.tres" id="c_carrier_bag_big"]
[ext_resource type="Resource" path="res://data/cards/milk.tres" id="e_milk"]

[resource]
script = ExtResource("1_pack")
id = &"big_shop"
display_name = "Big shop"
family = "Food"
cards = Array[ExtResource("2_card")]([ExtResource("c_final_markdown"), ExtResource("c_yogurt"), ExtResource("c_carrier_bag_big")])
hint_text = "Carrier bag between two Food: +8€ per Food beside it. Final markdown doubles the last."
example_text = "Final markdown, Yogurt, Big Carrier bag, Milk: the bag pays 3 + 16, Final markdown doubles Milk's 5, the last item. Total 31."
example_cards = Array[ExtResource("2_card")]([ExtResource("c_final_markdown"), ExtResource("c_yogurt"), ExtResource("c_carrier_bag_big"), ExtResource("e_milk")])
example_total = 31
