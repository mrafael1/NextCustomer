[gd_resource type="Resource" script_class="BuildDefinition" format=3]

[ext_resource type="Script" path="res://core/build_definition.gd" id="1_build"]
[ext_resource type="Script" path="res://core/card_definition.gd" id="2_card"]
[ext_resource type="Resource" path="res://data/cards/butter.tres" id="3_c"]
[ext_resource type="Resource" path="res://data/cards/cheese.tres" id="4_c"]
[ext_resource type="Resource" path="res://data/cards/cereal.tres" id="5_c"]
[ext_resource type="Resource" path="res://data/cards/yogurt.tres" id="6_c"]
[ext_resource type="Resource" path="res://data/cards/reduced_yogurt.tres" id="7_c"]
[ext_resource type="Resource" path="res://data/cards/scone.tres" id="8_c"]
[ext_resource type="Resource" path="res://data/cards/cream.tres" id="9_c"]

[resource]
script = ExtResource("1_build")
id = &"pair_up"
display_name = "Pair up"
measure = 5
min_count = 3
cards = Array[ExtResource("2_card")]([ExtResource("3_c"), ExtResource("4_c"), ExtResource("5_c"), ExtResource("6_c"), ExtResource("7_c"), ExtResource("8_c"), ExtResource("9_c")])
measure_only = true
perk_ids = Array[StringName]([&"perfect_pair"])
