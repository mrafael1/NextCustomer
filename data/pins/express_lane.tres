[gd_resource type="Resource" script_class="PinDefinition" format=3]

[ext_resource type="Script" path="res://core/pin_definition.gd" id="1_pin"]
[ext_resource type="Script" path="res://core/inspection_definition.gd" id="2_event"]
[ext_resource type="Script" path="res://core/inspections/inspection_rule.gd" id="3_rule"]
[ext_resource type="Script" path="res://core/inspections/end_slots_multiplier_rule.gd" id="4_ends"]
[ext_resource type="Texture2D" uid="uid://bc3mqpk5lw5hv" path="res://art/pin_icons/express_lane.png" id="9_icon"]
[ext_resource type="Texture2D" uid="uid://w5riuiq40fm7" path="res://art/pin_icons/express_lane_big.png" id="10_icon_big"]

[sub_resource type="Resource" id="Resource_ends"]
script = ExtResource("4_ends")
factor = 2
receipt_text = "Express lane ×2"

[sub_resource type="Resource" id="Resource_event"]
script = ExtResource("2_event")
id = &"express_lane"
display_name = "Express lane"
tone = 1
notice_text = "The first and last items pay ×2"
chip_text = "Ends ×2"
icon_ref = "res://art/icons/coin.png"
rules = Array[ExtResource("3_rule")]([SubResource("Resource_ends")])

[resource]
script = ExtResource("1_pin")
id = &"express_lane"
display_name = "Express lane"
rule_text = "2 fewer slots; the first and last items pay ×2"
face_text = "EXP"
face_colour = 7
icon = ExtResource("9_icon")
icon_big = ExtResource("10_icon_big")
slot_delta = -2
events = Array[ExtResource("2_event")]([SubResource("Resource_event")])
