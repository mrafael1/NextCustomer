[resource]
script = ExtResource("7_deck")
id = &"guided_starter"
display_name = "Guided starter"
description = "The guided first run's cart: 2 Bananas, Milk, Eggs, Bread and Coffee, the starter pack you pick, and 2 fixed boosters (data/tutorial/guided_start.tres)."
core_cards = Array[ExtResource("1_card")]([ExtResource("2_banana"), ExtResource("2_banana"), ExtResource("3_milk"), ExtResource("4_eggs"), ExtResource("5_bread"), ExtResource("6_coffee")])
random_count = 6
copy_max = 2
starter_packs = Array[ExtResource("8_pack")]([ExtResource("p_breakfast_run"), ExtResource("p_deli_counter"), ExtResource("p_banana_bunch")])
packs_offered = 3
first_pick_pack = ExtResource("p_breakfast_run")
