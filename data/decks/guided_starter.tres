[resource]
script = ExtResource("7_deck")
id = &"guided_starter"
display_name = "Guided starter"
description = "The guided first run's cart: the regulars (2 Bananas, Milk, Eggs) and 2 fixed boosters (data/tutorial/guided_start.tres)."
core_cards = Array[ExtResource("1_card")]([ExtResource("2_banana"), ExtResource("2_banana"), ExtResource("3_milk"), ExtResource("4_eggs")])
random_count = 8
copy_max = 2
opening_time = true
