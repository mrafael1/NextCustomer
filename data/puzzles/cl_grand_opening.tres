[resource]
script = ExtResource("1_puzzle")
id = &"cl_grand_opening"
title = "Grand opening"
pack = 3
target = 39
slot_count = 5
hand = Array[ExtResource("2_card")]([ExtResource("c_opening_deal"), ExtResource("c_mixed_herbs"), ExtResource("c_bread"), ExtResource("c_cheese"), ExtResource("c_eggs"), ExtResource("c_potatoes"), ExtResource("c_banana")])
solution = PackedStringArray("opening_deal", "bread", "cheese", "mixed_herbs", "banana")
hint = "Opening deal in slot 1 makes the next item pay ×5. Bigger is not the goal."
