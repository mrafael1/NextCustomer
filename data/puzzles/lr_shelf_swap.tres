[resource]
script = ExtResource("1_puzzle")
id = &"lr_shelf_swap"
title = "Shelf swap"
pack = 2
target = 29
slot_count = 4
hand = Array[ExtResource("2_card")]([ExtResource("c_shelf_swap"), ExtResource("c_cheese"), ExtResource("c_bread"), ExtResource("c_butter"), ExtResource("c_croissant"), ExtResource("c_potatoes")])
