[resource]
script = ExtResource("1_puzzle")
id = &"lr_two_for_one"
title = "Two for one"
pack = 2
target = 20
slot_count = 4
hand = Array[ExtResource("2_card")]([ExtResource("c_two_for_one"), ExtResource("c_bread"), ExtResource("c_bread"), ExtResource("c_soup"), ExtResource("c_mixed_herbs"), ExtResource("c_banana")])
solution = PackedStringArray("bread", "two_for_one", "bread", "banana")
hint = "Between two of the same item, Two for one makes the second pay ×2."
