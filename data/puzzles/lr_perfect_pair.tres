[resource]
script = ExtResource("1_puzzle")
id = &"lr_perfect_pair"
title = "Perfect pair"
pack = 2
target = 46
slot_count = 4
hand = Array[ExtResource("2_card")]([ExtResource("c_butter"), ExtResource("c_scone"), ExtResource("c_cheese"), ExtResource("c_bread"), ExtResource("c_cereal"), ExtResource("c_milk")])
upgrades = Array[ExtResource("3_upgrade")]([ExtResource("u_perfect_pair")])
solution = PackedStringArray("bread", "cheese", "scone", "milk")
hint = "Items beside their PAIR partner pay ×2."
