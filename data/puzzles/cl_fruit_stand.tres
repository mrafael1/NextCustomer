hand = Array[ExtResource("2_card")]([ExtResource("c_banana"), ExtResource("c_lemon"), ExtResource("c_banana"), ExtResource("c_strawberries"), ExtResource("c_wonky_carrot"), ExtResource("c_grapefruit"), ExtResource("c_potatoes")])
