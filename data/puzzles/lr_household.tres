[resource]
script = ExtResource("1_puzzle")
id = &"lr_household"
title = "Household goods"
pack = 2
target = 35
slot_count = 4
hand = Array[ExtResource("2_card")]([ExtResource("c_batteries"), ExtResource("c_odd_socks"), ExtResource("c_carrier_bag"), ExtResource("c_chipped_mug"), ExtResource("c_coffee"), ExtResource("c_bread")])
