[resource]
script = ExtResource("1_puzzle")
id = &"cl_party_pack"
title = "Party pack"
pack = 3
target = 59
slot_count = 5
hand = Array[ExtResource("2_card")]([ExtResource("c_party_pack"), ExtResource("c_pick_n_mix"), ExtResource("c_cereal_bar"), ExtResource("c_bent_lolly"), ExtResource("c_breadsticks"), ExtResource("c_bread"), ExtResource("c_potatoes")])
