[resource]
script = ExtResource("1_puzzle")
id = &"op_breakfast_for_one"
title = "Breakfast for one"
pack = 1
target = 34
slot_count = 4
hand = Array[ExtResource("2_card")]([ExtResource("c_milk"), ExtResource("c_cereal"), ExtResource("c_coffee"), ExtResource("c_bread"), ExtResource("c_croissant"), ExtResource("c_eggs")])
upgrades = Array[ExtResource("3_upgrade")]([ExtResource("u_breakfast_regulars")])
pins = Array[ExtResource("5_pin")]([ExtResource("p_repack")])
solution = PackedStringArray("coffee", "eggs", "cereal", "milk")
hint = "Each Breakfast item gets +1€ for each Breakfast item before it."
