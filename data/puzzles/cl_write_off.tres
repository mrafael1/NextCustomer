[resource]
script = ExtResource("1_puzzle")
id = &"cl_write_off"
title = "Write-off"
pack = 3
target = 56
slot_count = 5
hand = Array[ExtResource("2_card")]([ExtResource("c_write_off"), ExtResource("c_flickering_bulb"), ExtResource("c_dusty_toffees"), ExtResource("c_bread"), ExtResource("c_cheese"), ExtResource("c_potatoes"), ExtResource("c_banana")])
