[resource]
script = ExtResource("1_puzzle")
id = &"op_spot_check"
title = "Spot check"
pack = 1
target = 17
slot_count = 4
hand = Array[ExtResource("2_card")]([ExtResource("c_bread"), ExtResource("c_cheese"), ExtResource("c_banana"), ExtResource("c_banana"), ExtResource("c_potatoes"), ExtResource("c_eggs")])
inspections = Array[ExtResource("4_event")]([ExtResource("e_spot_check")])
solution = PackedStringArray("eggs", "cheese", "bread")
hint = "Slot 3 pays 0€ today: choose what stands there."
