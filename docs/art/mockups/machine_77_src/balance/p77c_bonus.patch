+## p77c: the inspection bonus ticket is due after a passed shift that had an inspection (or
+## after an extra shift named by bonusextra). Phase is SCORED after the first visit.
+func _p77_bonus_due(run: RunState) -> bool:
+	if run.phase != RunState.Phase.SCORED:
+		return false
+	var shift: int = run.shift_index + 1
+	if _p77_bonus_shifts.has(shift):
+		return true
+	return _p77_bonus and not run.inspections.is_empty()
